---
// Galería de borde a borde sobre noche (banda con cúpula): mosaico sin márgenes (filete de 3 px) que toca los dos bordes de la ventana.
// La primera foto (y luego una de cada nueve) es grande, 2 × 2; el resto, celdas iguales: con 5 o 9 fotos el
// mosaico queda cerrado. Fotos en site.yaml → secciones.<id>.galeria (lista de rutas).
import { seccion } from '../../data/site';
import { altGaleria } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const fotos = s?.galeria ?? [];
---

{
  s && fotos.length > 0 && (
    <Seccion id={Astro.props.id} banda="noche" class="!pb-0" sangre cupula>
      <div class="contenedor">
        <Titular alinear="partido" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      </div>
      <ul class="mosaico">
        {fotos.map((foto, i) => (
          <li class:list={{ 'mosaico-grande': i % 9 === 0 && fotos.length > 2 }}>
            <Imagen src={foto} alt={altGaleria(i)} ancho={i % 9 === 0 ? 1600 : 900} alto={i % 9 === 0 ? 1200 : 675} />
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
