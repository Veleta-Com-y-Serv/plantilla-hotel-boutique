---
// Opiniones sobre piedra: la primera, enorme, en garalda redonda con comillas doradas; el resto en columnas con
// filete dorado encima. `testimonios` [{texto, autor, nota}]; `nota` opcional (de dónde viene o cuándo).
// Sin opiniones, la sección no se pinta. Sin estrellas ni puntuaciones.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const [primera, ...resto] = s?.testimonios ?? [];
---

{
  s && primera && (
    <Seccion id={Astro.props.id} banda="piedra">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <figure class="opinion-grande">
        <blockquote>{primera.texto}</blockquote>
        {(primera.autor || primera.nota) && (
          <figcaption class="opinion-autor rotulo">
            {primera.autor && <span>{primera.autor}</span>}
            {primera.nota && <span class="opinion-nota">{primera.nota}</span>}
          </figcaption>
        )}
      </figure>
      {resto.length > 0 && (
        <ul class="opiniones-resto">
          {resto.map((t) => (
            <li>
              <figure>
                <blockquote>{t.texto}</blockquote>
                {(t.autor || t.nota) && (
                  <figcaption class="opinion-autor rotulo">
                    {t.autor && <span>{t.autor}</span>}
                    {t.nota && <span class="opinion-nota">{t.nota}</span>}
                  </figcaption>
                )}
              </figure>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}
