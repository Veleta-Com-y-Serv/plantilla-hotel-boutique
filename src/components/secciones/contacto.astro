---
// Contacto sobre piedra: a la izquierda, titular y vías de contacto en letra grande (teléfono, WhatsApp, email,
// dirección y horario de site.yaml → contacto) entre filetes; a la derecha, el formulario (mailto) en un bloque noche.
import { seccion, site, tel, whatsapp, mapa } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
---

{
  s && (
    <Seccion id={Astro.props.id} banda="piedra">
      <div class="contacto-rejilla">
        <div>
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {(c.telefono || c.whatsapp || c.email || c.direccion || c.horario) && (
            <ul class="vias">
              {c.telefono && (
                <li>
                  <span class="vias-etiqueta rotulo">Teléfono</span>
                  <a class="vias-dato" href={tel(c.telefono)}>{c.telefono}</a>
                </li>
              )}
              {c.whatsapp && (
                <li>
                  <span class="vias-etiqueta rotulo">WhatsApp</span>
                  <a class="vias-dato" href={whatsapp(c.whatsapp, `Hola, os escribo desde la web de ${site.nombre}`)} rel="noopener" target="_blank">{c.whatsapp}</a>
                </li>
              )}
              {c.email && (
                <li class="sm:col-span-2">
                  <span class="vias-etiqueta rotulo">Email</span>
                  <a class="vias-dato" href={`mailto:${c.email}`}>{c.email}</a>
                </li>
              )}
              {c.direccion && (
                <li class="sm:col-span-2">
                  <span class="vias-etiqueta rotulo">Dirección</span>
                  <a class="vias-dato" href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a>
                </li>
              )}
              {c.horario && (
                <li class="sm:col-span-2">
                  <span class="vias-etiqueta rotulo">Horario</span>
                  <span class="text-[1rem] leading-relaxed">{c.horario}</span>
                </li>
              )}
            </ul>
          )}
        </div>
        <div class="contacto-form">
          <FormularioContacto oscuro prefijo={`c-${Astro.props.id}`} boton="Enviar" />
        </div>
      </div>
    </Seccion>
  )
}
