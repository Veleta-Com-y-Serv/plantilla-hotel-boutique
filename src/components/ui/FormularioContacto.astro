---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con todos los campos en el cuerpo.
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// `estancia`: añade llegada, salida y número de personas (sección reservas). `oscuro`: sobre una banda oscura.
import { site } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; estancia?: boolean; prefijo?: string; oscuro?: boolean }
const {
  boton = 'Enviar mensaje',
  class: clase = '',
  asunto = `Consulta desde la web de ${site.nombre}`,
  estancia = false,
  prefijo = 'f',
  oscuro = false,
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const id = (c: string) => `${prefijo}-${c}`;
---

<form class:list={['formulario', { 'formulario--oscuro': oscuro }, clase]} action={accion || undefined} method="post" enctype="text/plain">
  {
    estancia && (
      <div class="formulario-fila formulario-fila--fechas">
        <div class="campo">
          <label for={id('llegada')}>Llegada</label>
          <input id={id('llegada')} name="llegada" type="date" required />
        </div>
        <div class="campo">
          <label for={id('salida')}>Salida</label>
          <input id={id('salida')} name="salida" type="date" required />
        </div>
        <div class="campo">
          <label for={id('personas')}>Personas</label>
          <input id={id('personas')} name="personas" type="number" min="1" max="30" inputmode="numeric" required />
        </div>
      </div>
    )
  }
  <div class="formulario-fila">
    <div class="campo">
      <label for={id('nombre')}>Nombre</label>
      <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for={id('contacto')}>Email o teléfono</label>
      <input id={id('contacto')} name="contacto" type="text" autocomplete="email" required />
    </div>
  </div>
  <div class="campo">
    <label for={id('mensaje')}>{estancia ? 'Algo más que debamos saber (niños, mascota, hora de llegada…)' : 'Mensaje'}</label>
    <textarea id={id('mensaje')} name="mensaje" rows={estancia ? 3 : 4} required={!estancia}></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>
