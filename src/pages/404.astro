---
// Página no encontrada con el diseño de la plantilla: banda noche a pantalla casi completa, cifra garalda en oro.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--noche flex min-h-[80svh] items-center">
    <div class="contenedor grid items-center gap-10 lg:grid-cols-[6fr_5fr] lg:gap-20">
      <p class="error-cifra" aria-hidden="true">404</p>
      <div>
        <p class="antetitulo">Página no encontrada</p>
        <h1 class="titulo-seccion">Esta puerta no da a ninguna habitación</h1>
        <p class="titular-texto">Puede que el enlace esté mal o que la página se haya movido. Vuelve a la portada de {site.nombre}.</p>
        <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
      </div>
    </div>
  </section>
</Base>
